# Copy to .env: cp .env.example .env
#
# WARNING: every default below is for LOCAL DEVELOPMENT ONLY.
# Change all credentials before deploying anywhere reachable by other people.

# Postgres
POSTGRES_USER=autolabel
POSTGRES_PASSWORD=autolabel
POSTGRES_DB=autolabel

# MinIO / S3
MINIO_ROOT_USER=autolabel
MINIO_ROOT_PASSWORD=autolabel123
S3_BUCKET=autolabel
S3_ACCESS_KEY=autolabel
S3_SECRET_KEY=autolabel123

# Public S3 endpoint used in presigned URLs (opened by the user's browser).
# Required when deploying on anything other than localhost — otherwise
# presigned image links break. Must be reachable from the browser.
# S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# CORS (frontend dev server)
CORS_ORIGINS=http://localhost:5173

# VLM labeler defaults — any OpenAI-compatible API (Modal, OpenRouter,
# Ollama, vLLM, ...). base_url/model can be overridden per-run in the engine
# config JSON in the UI; keep the API key HERE — engine config JSON is stored
# in the DB in plaintext.
# VLM_BASE_URL=http://host.docker.internal:11434/v1
# VLM_MODEL=qwen2.5vl:7b
# VLM_API_KEY=

# Build the worker image with the local PaddleOCR CPU engine included
# (adds several GB — off by default, heavy inference belongs on Modal).
# WITH_PADDLE=1

# Secrets and GPU mode
# Encryption key for the Modal token: auto-generated on first start (a file on
# the volume). Set it explicitly to keep the key outside the container.
# SETTINGS_ENCRYPTION_KEY=
# SETTINGS_KEY_PATH=/data/settings.key
#
# Name of the Modal app the platform deploys from the "Connect GPU" button
# MODAL_GPU_APP_NAME=nounbox-gpu
# MODAL_GPU_RECIPE_PATH=/deploy/modal/paddleocr_modal.py
#
# Bearer token of the GPU endpoint. By default the platform generates it during
# deploy and stores it encrypted — set this only if you need a fixed one.
# NOUNBOX_GPU_TOKEN=

# Access token for the settings endpoints (entering the Modal token, starting a
# GPU deploy). If left empty, those endpoints are open to anyone who can reach
# port. Set it if the platform is reachable by anyone besides you:
#   APP_ACCESS_TOKEN=$(openssl rand -hex 32)
# APP_ACCESS_TOKEN=
